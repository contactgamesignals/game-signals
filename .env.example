# Optional public app overrides
# The repository contains the public GameSignal Supabase URL and publishable key as safe defaults.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Used only by server-side setup or deployment scripts. Never expose publicly.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Supabase Edge Function secrets (set with `supabase secrets set ...`)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=
CRON_SECRET=generate-a-long-random-value
DISCORD_USER_AGENT=GameSignal/0.1 (+https://your-domain.example)
