# Optional public app overrides.
# The repository contains the public GameSignal Supabase URL and publishable key as safe defaults.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only. Never expose these values publicly or commit real values.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase Edge Function secrets. Set them in the Supabase dashboard or with `supabase secrets set`.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=
DISCORD_USER_AGENT=GameSignal/0.1 (+https://game-signals.vercel.app)
