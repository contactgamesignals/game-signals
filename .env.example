# Optional public app overrides.
# The repository contains safe public defaults for the connected Who Plays My Game Supabase project.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Public Cloudflare Turnstile widget key used by signup/login/password-recovery forms.
# This value is intentionally public; the Turnstile secret stays only in Supabase Auth settings.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAESFe84BxL0zJH7I

# Used only by server-side setup or deployment scripts. Never expose publicly.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Comma-separated Supabase Auth user UUIDs allowed to view global operator-only
# launch/accounting readiness state. Empty or malformed configuration fails closed.
GAMESIGNAL_OPERATOR_USER_IDS=

# Historical GAMESIGNAL_* variable names are intentionally retained for runtime compatibility.
# Production public URL used by server/Edge Function fallbacks.
GAMESIGNAL_SITE_URL=https://www.whoplaysmygame.com

# Current Paddle MoR paid-launch approvals. All approvals default to false and are
# administrative evidence only: they never bypass the runtime Paddle LIVE lock.
GAMESIGNAL_LIVE_SELLER_APPROVED=false
GAMESIGNAL_SUPPORT_PHONE=
GAMESIGNAL_LEGAL_DOCUMENTS_APPROVED=false
GAMESIGNAL_CONTRACT_CONFIRMATION_READY=false
GAMESIGNAL_PADDLE_ACCOUNT_READY=false
GAMESIGNAL_PADDLE_DOMAIN_READY=false
GAMESIGNAL_PADDLE_CATALOG_READY=false
GAMESIGNAL_PADDLE_WEBHOOK_READY=false
GAMESIGNAL_PADDLE_PORTAL_READY=false
GAMESIGNAL_PADDLE_ACCOUNTING_READY=false
GAMESIGNAL_SUPABASE_AUTH_READY=false
GAMESIGNAL_AUTH_EMAIL_READY=false
GAMESIGNAL_PADDLE_LIVE_APPROVED=false

# Default provider for new subscriptions. Existing subscriptions keep their stored provider.
# Paddle is currently configured/tested only in SANDBOX; LIVE remains separately locked.
GAMESIGNAL_BILLING_PROVIDER=paddle

# Paddle Merchant-of-Record integration. Sandbox and LIVE use completely separate credentials.
PADDLE_ENV=sandbox
PADDLE_BILLING_ENABLED=false
# Explicit developer-only switch for creating new Sandbox checkouts. Keep false/absent
# on the public production service so test purchases cannot be mistaken for real sales.
PADDLE_SANDBOX_CHECKOUT_ENABLED=false
PADDLE_LIVE_BILLING_ENABLED=false
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_CHECKOUT_URL=https://www.whoplaysmygame.com/pay
PADDLE_PRICE_INDIE_MONTHLY=
PADDLE_PRICE_INDIE_YEARLY=
PADDLE_PRICE_STUDIO_MONTHLY=
PADDLE_PRICE_STUDIO_YEARLY=
PADDLE_PRICE_PUBLISHER_MONTHLY=
PADDLE_PRICE_PUBLISHER_YEARLY=

# Supabase Edge Function secrets. Set them in the Supabase dashboard or with `supabase secrets set`.
STRIPE_SECRET_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Who Plays My Game <alerts@YOUR_VERIFIED_DOMAIN>
DISCORD_USER_AGENT=WhoPlaysMyGame/0.1 (+https://www.whoplaysmygame.com)

# Legacy/direct Stripe billing readiness flags. They are retained only for the
# rollback path and do not gate the current Paddle MoR launch route.
GAMESIGNAL_STRIPE_ACCOUNT_READY=false
GAMESIGNAL_STRIPE_RECOVERY_READY=false
GAMESIGNAL_STRIPE_DISPUTES_READY=false
GAMESIGNAL_STRIPE_API_VERSION_READY=false
GAMESIGNAL_STRIPE_LIVE_APPROVED=false

# KSeF server-only configuration for the legacy/direct seller-invoice route.
# Keep KSEF_ENABLED=false and KSEF_PRODUCTION_UNLOCK empty unless that route is
# separately authorized. Paddle customer transactions do not use this KSeF path.
GAMESIGNAL_KSEF_FLOW_READY=false
KSEF_ENV=test
KSEF_ENABLED=false
KSEF_PRODUCTION_UNLOCK=
KSEF_SYSTEM_TOKEN=
KSEF_FINAL_SELLER_NIP=
KSEF_FINAL_SELLER_CONFIRMED_AT=
KSEF_INVOICE_WRITE_VERIFIED_AT=

# Stripe webhook signing secrets are retained only for the legacy/direct Stripe route.
# They must never be committed to this repository.
