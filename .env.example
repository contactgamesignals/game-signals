# Optional public app overrides.
# The repository contains the public GameSignal Supabase URL and publishable key as safe defaults.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Used only by server-side setup or deployment scripts. Never expose publicly.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Comma-separated Supabase Auth user UUIDs allowed to view global operator-only
# launch/accounting readiness state. Empty or malformed configuration fails closed.
GAMESIGNAL_OPERATOR_USER_IDS=

# Supabase Edge Function secrets. Set them in the Supabase dashboard or with `supabase secrets set`.
STRIPE_SECRET_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=GameSignal <alerts@YOUR_VERIFIED_DOMAIN>
DISCORD_USER_AGENT=GameSignal/0.1 (+https://game-signals.vercel.app)

# KSeF server-only configuration. Never prefix these with NEXT_PUBLIC_.
# Keep KSEF_ENABLED=false and KSEF_PRODUCTION_UNLOCK empty until the separately
# authorized legal go-live step. Production readiness can be prepared while the
# actual submission path remains locked.
KSEF_ENV=test
KSEF_ENABLED=false
KSEF_PRODUCTION_UNLOCK=
KSEF_SYSTEM_TOKEN=
KSEF_FINAL_SELLER_NIP=
KSEF_FINAL_SELLER_CONFIRMED_AT=
KSEF_INVOICE_WRITE_VERIFIED_AT=

# The Stripe webhook signing secret is generated by Stripe and stored in Supabase Vault.
# It must never be committed to this repository.
